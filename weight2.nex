#NEXUS
begin data;
dimension ntax=25 nchar=21;
matrix
LZJ       000100001111000010000
LZY       000100001101000010000
LZB       000100001101000010000
TYSS      000100001101000010000
YCAA      100000000100100001000
YCBB      000100000100100001000
ZYA       111100000100100001000
ZYB       101100100100100001000
WXA       111010000100100001000
WXB       101110000100100001000
WXC       101000000100100001000
LMGWZS    111100001100100001000
QDYS      101100001100100001000
TYZD      000110000000001000010
ZXZD      000010000000001000010
YCY       000111001000010000100
YCE       000111101000010000100
YCSA      000111100000010000100
YCSB      000111101100010000100
YCSC      000011101000010000100
YCSD      000111001100010000100
CZWZ      000100010010000100001
ZDY       000100011000000100001
XZMC      000100011010000100001
LD        000100011110000100001
;
end;

begin paup;
    log file=paup_bootstrap_search.log start replace=yes;
    set increase=auto;
    outgroup LZJ;
    bootstrap nreps=100 search=heuristic/ addseq=random nreps=100 swap=tbr;
    contree all/majRule=yes LE50=yes treeFile=paup_majRule.nex format=Nexus saveSupport=Both saveAsRooted=yes outRoot=paraphyletic;
    log stop;
    quit;
end;


